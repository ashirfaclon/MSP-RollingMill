# The frontend holds NO plant credentials — those live in the backend (backend/.env.example).

# Production build (`next build` → static site in out/): the browser calls the backend
# directly. Inlined at build time, so it must be set BEFORE building — commit it in
# .env.production (a public URL, not a secret) or set it in the build environment.
# Must be https when the site is served over https. The backend must list this site's
# origin in CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=

# Local development (`next dev`, in .env.local): /api/* is proxied here instead — leave
# NEXT_PUBLIC_API_BASE_URL empty in .env.local to use it.
BACKEND_URL=http://localhost:4000
