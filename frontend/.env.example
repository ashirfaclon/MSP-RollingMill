# Copy to .env.local (gitignored). The frontend holds NO plant credentials — those live in
# the backend (backend/.env.example). Pick ONE of the two ways to reach the API:

# 1) Same-origin proxy (default): the browser calls /api/* on this site and Next forwards it.
#    Read at BUILD time (next build) — set it before building.
BACKEND_URL=http://localhost:4000

# 2) Direct: the browser calls the backend itself. Inlined at build time. The backend must
#    then list this site's origin in CORS_ORIGINS. Leave empty to use the proxy.
NEXT_PUBLIC_API_BASE_URL=
