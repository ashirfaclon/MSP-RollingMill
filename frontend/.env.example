# Copy to .env.local (gitignored) and fill in. Shapes only — never commit real values.
# One namespace per physical system, so a mis-set variable cannot query the wrong server.

# --- Process historian (InfluxDB v2, over the plant VPN) ---
INFLUX_URL=                 # http://10.x.x.x:8086
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_TOKEN=
INFLUX_USER=                # v1 fallback: leave TOKEN empty, set user + password
INFLUX_PASSWORD=

# --- Electrical meters / EMS (a DIFFERENT InfluxDB) ---
EMS_INFLUX_URL=
EMS_INFLUX_ORG=
EMS_INFLUX_BUCKET=          # defaults to "EMS Data"
EMS_INFLUX_TOKEN=

# --- ERP (Oracle) · READ-ONLY · used only by `npm run sync:erp`, never by the app ---
ERP_DSN=                    # host:port/service_name
ERP_USER=
ERP_PASSWORD=
ERP_ORACLE_CLIENT_DIR=      # e.g. /opt/oracle/instantclient_23_26 (thick mode required)
ERP_CACHE_DIR=data          # relative to frontend/, gitignored

# --- IOsense logbook ---
IOSENSE_PAT=                # Personal Access Token — seeds a server-side session (no expiry)
IOSENSE_BEARER=             # or "Bearer <jwt>" for a dev session
IOSENSE_BASE=https://connector.iosense.io
IOSENSE_ORG=https://iosense.io
IOSENSE_HSM_INSIGHT_ID=     # the insight serving HSM's forms — not yet known

# --- App ---
POLL_INTERVAL_SECONDS=60
