# Copy to backend/.env (gitignored) for local runs; in production set these on the platform.
# Shapes only — never commit real values.

# --- HTTP service ---
NODE_ENV=development            # production in deployment
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
CORS_ORIGINS=                   # frontend origin(s), comma-separated, e.g. https://hsm.example.com
                                # leave empty when the frontend proxies /api (same origin)
TRUST_PROXY=false               # true behind a load balancer / reverse proxy
RATE_LIMIT_PER_MINUTE=600       # per client IP; 0 = off
ERP_SYNC_INTERVAL_MINUTES=0     # e.g. 180 to sync the ERP every 3 h inside the service; 0 = run it from cron

# --- Process historian (InfluxDB v2, over the plant VPN) ---
INFLUX_URL=                     # http://10.x.x.x:8086
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_TOKEN=
INFLUX_USER=                    # v1 fallback: leave TOKEN empty, set user + password
INFLUX_PASSWORD=

# --- Electrical meters / EMS (a DIFFERENT InfluxDB) ---
EMS_INFLUX_URL=
EMS_INFLUX_ORG=
EMS_INFLUX_BUCKET=              # defaults to "EMS Data"
EMS_INFLUX_TOKEN=

# --- ERP (Oracle) · READ-ONLY · used only by the ERP sync job, never by a request ---
ERP_DSN=                        # host:port/service_name
ERP_USER=
ERP_PASSWORD=
ERP_ORACLE_CLIENT_DIR=          # e.g. /opt/oracle/instantclient_23_26 (thick mode required)
ERP_CACHE_DIR=data              # relative to backend/; mount a volume here in a container

# --- IOsense logbook ---
IOSENSE_PAT=                    # Personal Access Token — seeds a server-side session
IOSENSE_BEARER=                 # or "Bearer <jwt>" for a dev session
IOSENSE_BASE=https://connector.iosense.io
IOSENSE_ORG=https://iosense.io
IOSENSE_HSM_INSIGHT_ID=         # the insight serving HSM's forms — not yet known

# --- Shared with the frontend ---
POLL_INTERVAL_SECONDS=60
