{
  "name": "msp-rollingmill-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MSP Rolling Mill API \u2014 HSM KPIs computed from the plant historian (InfluxDB) and the ERP (Oracle, read-only)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:live": "vitest run --project live",
    "test:watch": "vitest --project unit",
    "sync:erp": "tsx --env-file-if-exists=.env src/jobs/erp-sync.ts",
    "sync:erp:prod": "node --env-file-if-exists=.env dist/erp-sync.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@influxdata/influxdb-client": "^1.35.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "oracledb": "^7.0.1",
    "tsup": "^8.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/oracledb": "^7.0.3",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
